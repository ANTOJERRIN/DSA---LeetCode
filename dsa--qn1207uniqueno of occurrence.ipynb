the python code implementation is 
  class Solution:
    def uniqueOccurrences(self, arr: list[int]) -> bool:
        s={}
        n=len(arr)
        for i in range(0,n):
            s[arr[i]]=s.get(arr[i],0)+1
        seen=set()
        for i in s:
            e=s[i]
            if e in seen:
                return False
            seen.add(e)
        return True            


  the c++ code implementation is 
          class Solution {
public:
    bool uniqueOccurrences(vector<int>& arr) {
        int n = arr.size();

        // Step 1: Count how many times each number appears
        unordered_map<int, int> freq;

        for (int i = 0; i < n; i++) {
            freq[arr[i]]++;
        }

        // Step 2: Keep track of frequencies already seen
        unordered_set<int> seen;

        for (auto entry : freq) {
            int count = entry.second;

            // If this count was already seen, it is not unique
            if (seen.count(count) > 0) {
                return false;
            }

            seen.insert(count);
        }

        // All frequencies were different
        return true;
    }
};
