(*the c++ soln is below *)
class Solution {
public:
    int countPrimes(int n) {
        if(n < 2) return 0;
        
        // vector<char> is the fastest option: no bit-shifting overhead, and very low memory.
        vector<char> v(n, 1); 
        
        v[0] = 0;
        v[1] = 0;
        
        for(int i = 2; i * i < n; i++) {
            if(v[i] == 1) {
                for(int j = i * i; j < n; j += i) {
                    v[j] = 0;
                }
            }
        }
        
        int c = 0;
        for(int i = 2; i < n; i++) {
            if(v[i] == 1) {
                c++;
            }
        }
        
        return c;
    }
};
