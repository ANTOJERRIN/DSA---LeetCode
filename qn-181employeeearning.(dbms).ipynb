    "# mysql query\n",
    "# Write your MySQL query statement below\n",
    "select e.name as employee\n",
    "from employee e\n",
    "join employee m\n",
    "     on e.managerId=m.id\n",
    "where e.salary>m.salary;     \n"
   ]
