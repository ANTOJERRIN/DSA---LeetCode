the pyhton solution for this prblem is :
class Solution:
    def missingNumber(self, nums: list[int]) -> int:
        n=len(nums)
        es=n*(n+1)//2
        a_s=0

        for num in nums:
            a_s=a_s+num
        return es-a_s  


the c++ solution for this problem is:
class Solution {
public:
    int missingNumber(vector<int>& nums) {
        int n=nums.size();
        int es=n*(n+1)/2;
        int as=0;
        for(int n:nums)
        {
            as+=n;
        }
        return es-as;
        
    }
};
